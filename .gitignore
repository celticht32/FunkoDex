.gradle/
build/
*/build/
*.apk
*.aab
*.ap_

# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
# NEVER commit — contains sdk.dir, workerUrl, and any local keys
local.properties

# OS
.DS_Store
Thumbs.db

# Test reports
test-results/
app/build/reports/

# Kotlin build cache
.kotlin/

# Couchbase Lite database (never commit user data)
*.cblite2/
*.cblite/

# launcher-icon/ — SVG sources, tracked
# Note: funko_data.json, font files, and mipmap-* launcher icons are
# intentionally committed (bundled assets) — do not add ignore rules for them.

# Sensitive
google-services.json  # if Firebase/Google added later
keystore.jks
*.keystore
release/

# Forensic DB pulls (debugging artifacts, never commit)
db*.sqlite3
db*.sqlite3-wal
db*.sqlite3-shm

# Device log/backup exports pulled for debugging
FunkoDex_FULL_*.zip
FunkoDex_log_*.txt
funkodex_keys.*

# NOTE (2026-09): three dead rules were removed from here.
#   app/src/main/assets/funkodex_base_catalog.json.gz_   (listed twice)
#   app/src/main/java/com/funkodex/data/preload/CatalogPreloader.kt
# Both paths are TRACKED (verified against .git/index), so the rules had no
# effect -- .gitignore only governs untracked files. They were actively
# misleading: both are REQUIRED for a clone to build (DEC-027: the trailing
# underscore on the asset is load-bearing), and had either ever been
# `git rm --cached`-ed, the rule would have silently kept it out of the repo
# and left every clone unable to compile. A duplicate `*.apk` was also dropped;
# the one under "Android build outputs" above already covers it.
