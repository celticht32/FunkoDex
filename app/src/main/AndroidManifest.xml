<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- C1: Photo capture — gallery picker permissions -->
    <!-- READ_MEDIA_IMAGES required on Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- READ_EXTERNAL_STORAGE required on Android 12 and below -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".FunkoDexApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="FunkoDex"
        tools:replace="android:label"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FunkoDex"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            FileProvider: lets us share .xlsx/.csv files from cache via content:// URI.
            Required by Android 7+ for cross-app file sharing.
        -->
        <!-- Disable WorkManager's default initializer so FunkoDexApp.Configuration.Provider
             controls initialization — required for HiltWorkerFactory to be used. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FunkoDex.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            OAuthCallbackActivity: receives redirect URIs from HobbyDB and eBay OAuth flows.
            The Custom Tab redirects to funkodex://oauth/{provider}?code=AUTH_CODE.
            launchMode=singleTask: prevents stacking multiple instances during auth.
        -->
        <activity
            android:name=".auth.OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- HobbyDB OAuth redirect -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="funkodex"
                    android:host="oauth"
                    android:path="/hobbydb" />
            </intent-filter>
            <!-- eBay OAuth redirect -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="funkodex"
                    android:host="oauth"
                    android:path="/ebay" />
            </intent-filter>
        </activity>

        <!-- E3: Home screen widget receiver -->
        <receiver
            android:name=".ui.widget.CollectionWidgetReceiver"
            android:exported="true"
            android:label="FunkoDex Collection">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/collection_widget_info" />
        </receiver>

    </application>

</manifest>
