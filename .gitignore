# Android build outputs
.gradle/
build/
*/build/
*.apk
*.aab
*.ap_

# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
local.properties      # NEVER commit — contains workerUrl and any local keys

# OS
.DS_Store
Thumbs.db

# Test reports
test-results/
reports/

# Kotlin build cache
.kotlin/

# Couchbase Lite database (never commit user data)
*.cblite2/
*.cblite/

# Generated files
app/src/main/assets/funko_data.json  # downloaded separately — too large for git
app/src/main/res/font/               # download from Google Fonts
# launcher-icon/ is tracked — contains SVG source files
app/src/main/res/mipmap-*/           # generated PNGs — re-generate via Image Asset Studio

# Sensitive
google-services.json  # if Firebase/Google added later
keystore.jks
*.keystore
release/
